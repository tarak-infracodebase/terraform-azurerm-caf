# AWS Well-Architected Framework - Production Example Configuration
# Copy this file to terraform.tfvars and customize for your environment

# Global Settings
global_settings = {
  organization_name = "your-company"
  environment      = "production"
  project_name     = "your-project"
  cost_center      = "engineering"
  owner           = "platform-team"

  # Multi-region configuration
  primary_region   = "us-east-1"
  secondary_region = "us-west-2"

  # Additional tags
  tags = {
    BusinessUnit = "platform"
    Compliance   = "sox"
    DataClass    = "internal"
  }
}

# Account Configuration (for multi-account setup)
account_config = {
  enable_cross_account = false
  # primary_account_id   = "123456789012"  # Your primary AWS account ID
  # logging_account_id   = "123456789013"  # Your logging account ID
  # security_account_id  = "123456789014"  # Your security account ID
}

# Networking Configuration
networking = {
  vpc_cidr             = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true
  enable_nat_gateway   = true
  enable_vpn_gateway   = false
  enable_flow_logs     = true

  # Customize availability zones for your region
  availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

  # Advanced networking (enable based on requirements)
  enable_transit_gateway = false
  enable_direct_connect = false
}

# Well-Architected Pillars (enable/disable based on needs)
pillars = {
  operational_excellence = true
  security              = true
  reliability           = true
  performance_efficiency = true
  cost_optimization     = true
  sustainability        = true
}

# Security Configuration
security = {
  # Identity and Access
  enable_organizations = false  # Set to true for multi-account
  enable_sso          = false   # Set to true for SSO integration

  # Data Protection
  enable_kms            = true
  enable_secrets_manager = true

  # Threat Detection and Response
  enable_guardduty      = true
  enable_security_hub   = true
  enable_inspector      = true
  enable_macie         = false  # Enable for sensitive data discovery

  # Infrastructure Protection
  enable_waf           = true
  enable_shield        = false  # Enable Shield Advanced for DDoS protection

  # Compliance and Governance
  enable_config        = true
  enable_cloudtrail    = true
  enable_vpc_flow_logs = true
}

# Reliability Configuration
reliability = {
  enable_multi_az                   = true
  enable_auto_scaling              = true
  enable_backup                    = true
  enable_disaster_recovery         = false  # Enable for cross-region DR
  enable_application_load_balancer = true
  enable_network_load_balancer    = false  # Enable for TCP/UDP workloads
  enable_rds_multi_az             = true
  enable_aurora                   = false   # Enable for serverless databases
  enable_cloudwatch_alarms        = true
  enable_sns_notifications        = true
}

# Performance Configuration
performance_efficiency = {
  enable_ec2_optimization = true
  enable_lambda         = true
  enable_fargate        = false  # Enable for containerized workloads
  enable_s3_optimization = true
  enable_efs            = false  # Enable for shared file storage
  enable_database_optimization = true
  enable_elasticache    = false  # Enable for caching layer
  enable_cloudfront     = true
  enable_route53       = true
  enable_s3_transfer_acceleration = false
}

# Cost Optimization Configuration
cost_optimization = {
  enable_cost_explorer     = true
  enable_budgets          = true
  enable_reserved_instances = false  # Enable for predictable workloads
  enable_savings_plans    = false   # Alternative to Reserved Instances
  enable_spot_instances   = false   # Enable for fault-tolerant workloads
  enable_auto_scaling     = true
  enable_trusted_advisor  = true
  enable_compute_optimizer = true
  enable_cost_allocation_tags = true
}

# Sustainability Configuration
sustainability = {
  enable_carbon_footprint_tracking = true
  enable_sustainability_insights  = true
  enable_right_sizing             = true
  enable_graviton                 = false  # Enable for ARM-based instances
  prefer_renewable_energy_regions = true
  enable_resource_lifecycle       = true
}

# Compute Resources Configuration
compute = {
  # EC2 Auto Scaling Groups
  ec2_instances = {
    web_tier = {
      instance_type     = "t3.medium"
      min_size         = 2
      max_size         = 10
      desired_capacity = 3
      subnet_type      = "private"
      security_groups  = ["web"]

      tags = {
        Tier = "web"
        Role = "frontend"
      }
    }

    app_tier = {
      instance_type     = "t3.large"
      min_size         = 2
      max_size         = 8
      desired_capacity = 2
      subnet_type      = "private"
      security_groups  = ["app"]

      tags = {
        Tier = "app"
        Role = "backend"
      }
    }
  }

  # Lambda Functions
  lambda_functions = {
    api_handler = {
      runtime     = "python3.9"
      handler     = "lambda_function.lambda_handler"
      timeout     = 30
      memory_size = 256

      environment_variables = {
        ENVIRONMENT = "production"
        LOG_LEVEL   = "INFO"
      }
    }
  }
}

# Database Configuration
databases = {
  # RDS Instances
  rds_instances = {
    primary = {
      engine           = "mysql"
      engine_version   = "8.0"
      instance_class   = "db.t3.medium"
      allocated_storage = 100

      # High availability and backup
      multi_az                = true
      backup_retention_period = 30
      storage_encrypted       = true
      monitoring_interval     = 60

      tags = {
        Tier = "database"
        Role = "primary"
      }
    }
  }

  # DynamoDB Tables
  dynamodb_tables = {
    sessions = {
      name         = "user-sessions"
      billing_mode = "PAY_PER_REQUEST"
      hash_key     = "session_id"

      attributes = [
        {
          name = "session_id"
          type = "S"
        }
      ]

      point_in_time_recovery_enabled = true

      tags = {
        Tier = "cache"
        Role = "sessions"
      }
    }
  }
}

# Storage Configuration
storage = {
  s3_buckets = {
    # Static assets bucket
    assets = {
      bucket_name = "your-app-assets"

      versioning = {
        enabled = true
      }

      # Lifecycle management for cost optimization
      lifecycle_configuration = {
        rules = [
          {
            id     = "archive_old_versions"
            status = "Enabled"

            noncurrent_version_transitions = [
              {
                days          = 30
                storage_class = "STANDARD_IA"
              },
              {
                days          = 90
                storage_class = "GLACIER"
              }
            ]
          }
        ]
      }
    }

    # Application logs bucket
    logs = {
      bucket_name = "your-app-logs"

      lifecycle_configuration = {
        rules = [
          {
            id     = "delete_old_logs"
            status = "Enabled"

            expiration = {
              days = 90
            }
          }
        ]
      }
    }
  }
}